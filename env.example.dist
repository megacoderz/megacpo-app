# Mega Partner — sócio / investidor (self-service)
# Dev local: copie para .env (não commitar secrets)
APP_ENV=development
# Em device físico, use o IP LAN da máquina (não localhost)
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_APP_DISPLAY_NAME=Mega Partner
EXPO_PUBLIC_PRIMARY_COLOR=#0284c7

# Observabilidade (opcional)
EXPO_PUBLIC_SENTRY_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# --- EAS production (configurar no dashboard expo.dev) ---
# EXPO_PUBLIC_API_URL=https://api.megavoltz.com.br
# EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Ver megapartner/EAS_PUBLISH.md e: bun run validate:eas

# Dev em device com Personal Team (Apple ID gratuito):
# - bundle próprio (produção fica na conta paga)
# Depois: bun run prebuild:clean && bun run ios -- --device
# EXPO_IOS_PERSONAL_TEAM=1
# EXPO_IOS_BUNDLE_IDENTIFIER=br.com.megacoderz.megapartner.app
# EXPO_IOS_APPLE_TEAM_ID=DHJ693CU38

# Sunset do listing legado (…megapartner.app) — só na última build antiga:
# EXPO_PUBLIC_FORCE_UPGRADE=1
# EXPO_PUBLIC_STORE_URL_IOS=https://apps.apple.com/...
# EXPO_PUBLIC_STORE_URL_ANDROID=https://play.google.com/...
