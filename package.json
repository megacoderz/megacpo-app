{
  "name": "megacpo",
  "version": "1.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "main": "expo-router/entry",
  "scripts": {
    "prepare": "husky",
    "commit": "cz",
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint -- --no-cache",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"*.{ts,tsx,js,json,md}\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "expo:doctor": "bunx expo-doctor",
    "verify": "bun run lint && bun run typecheck && bun run test:cov",
    "verify:release": "bun run verify && bun run i18n:check && bun run expo:doctor",
    "validate:eas": "node ./scripts/validate-eas-env.js production",
    "validate:eas:preview": "node ./scripts/validate-eas-env.js preview",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform all",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:production:android": "eas build --profile production --platform android",
    "submit:production": "eas submit --profile production --platform all"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.9",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "typescript": "6.0.3",
    "glob": "^13.0.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
